# ============================================================================
# OpenIPC FPV 空中端 (drone / TX)
#   SoC      : HiSilicon Hi3518EV300  (family hi3516ev200, ARM Cortex-A7)
#   Sensor   : F23  ->  /etc/sensors/jxf23_i2c_1080p.ini
#   Flash    : 16 MB SPI NOR (split layout, firmware @ 0x50000)
#   Link     : wfb-ng 5.8GHz / 20MHz / MCS1 / FEC 8:12
#   Wireless : RTL8812AU, RTL8733BU
#
# 基线取自上游 br-ext-chip-hisilicon/configs/hi3518ev300_ultimate_defconfig。
# 工具链 / 内核 / 分区这几行必须与上游逐字一致，否则 Buildroot 取不到
# $(OPENIPC_TOOLCHAIN) 与 $(OPENIPC_KERNEL) 的下载地址。
# ============================================================================

# Architecture
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_EABI=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_ARM_INSTRUCTIONS_THUMB2=y

# Toolchain
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/openipc/firmware/releases/download/$(OPENIPC_TOOLCHAIN).tgz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-openipc-linux-musleabi"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_9=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# Kernel (Linux 4.9.37)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/openipc/linux/archive/$(OPENIPC_KERNEL).tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/hi3518ev300.generic.config"
BR2_LINUX_KERNEL_UIMAGE=y
BR2_LINUX_KERNEL_XZ=y

# Filesystem
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
BR2_PACKAGE_UBOOT_TOOLS=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_UBI=y
BR2_TARGET_ROOTFS_UBI_SUBSIZE=2048
BR2_TARGET_ROOTFS_UBI_USE_CUSTOM_CONFIG=y
BR2_TARGET_ROOTFS_UBI_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/ubinize-nand.cfg"
BR2_TARGET_ROOTFS_UBIFS_LEBSIZE=0x1f000

# OpenIPC
BR2_OPENIPC_SOC_VENDOR="hisilicon"
BR2_OPENIPC_SOC_MODEL="hi3518ev300"
BR2_OPENIPC_SOC_FAMILY="hi3516ev200"
BR2_OPENIPC_SNS_MODEL="f23"
# BR2_OPENIPC_VARIANT 只能取**一个不含斜杠的词**。原因有三，任何一条踩了
# 都会出问题：
#
#   1. 它被直接拼进产物文件名 —— Makefile:367/399/413 三处
#        tar -czf openipc.$(SOC_MODEL)-nor-$(VARIANT)-split.tgz
#      带斜杠会被当成子目录，tar 在**构建最后一步**报错，前面白编。
#   2. 多处按**词**匹配而非子串：
#        hisilicon-opensdk.mk:344   $(filter fpv wfbng,$(VARIANT))
#        majestic-webui.mk:22       $(filter fpv wfbng,$(VARIANT))
#      "fpv/wfbng" 是一个词，两个 filter 都不命中 —— 会悄悄丢掉 IMX307/
#      IMX335 的高帧率传感器库（正是 README §1.1 里那几条 60fps 备选方案）。
#   3. rtl8733bu-openipc.mk:10 用的是 $(findstring fpv,...)，子串匹配，
#      所以只要含 "fpv" 就能选对 rtl8733bu_fpv 分支 —— 这一条不受影响。
#
# 取 "fpv"：命中上面所有 $(filter fpv wfbng) 分支，无斜杠，也是 OpenIPC
# 对 FPV 构建的惯用取值。
BR2_OPENIPC_VARIANT="fpv"
BR2_OPENIPC_FLASH_SIZE="16"
BR2_OPENIPC_MAJESTIC="ultimate"

# ---- 基础工具 -------------------------------------------------------------
BR2_PACKAGE_CPU_MODELS=y
# 注意：本镜像沿用上游默认，root 是**空密码**，而这个 dropbear 用
# `-R -B -k -p 22` 启动 —— 其中 -B 就是「允许空密码登录」。
# 刷完机请立刻 `passwd root`，或按 docs/刷机与使用说明.md §7.1 改成只认公钥。
# 确实想在构建期固定密码（会进 git，不推荐）可加：
#   BR2_TARGET_GENERIC_ROOT_PASSWD="$(echo -n '你的密码' | mkpasswd -m sha-256 -s)"
BR2_PACKAGE_DROPBEAR_OPENIPC=y
BR2_PACKAGE_HISILICON_OPENSDK=y
BR2_PACKAGE_HISILICON_OSDRV_HI3516EV200=y
BR2_PACKAGE_IPCTOOL=y
BR2_PACKAGE_LINUX_FIRMWARE_OPENIPC=y
BR2_PACKAGE_LINUX_FIRMWARE_OPENIPC_MEDIATEK_MT7601U=y

# ---- 视频 / 图传 -----------------------------------------------------------
BR2_PACKAGE_MAJESTIC=y
BR2_PACKAGE_MAJESTIC_FONTS=y
BR2_PACKAGE_MAJESTIC_WEBUI=y
# wifibroadcast-ng 会自动 select: iw, mavfwd, msposd, libevent, jsonfilter,
# yaml-cli, yaml-cli-multi, libcurl(curl 二进制)
BR2_PACKAGE_WIFIBROADCAST_NG=y

# ---- USB Wi-Fi 驱动 --------------------------------------------------------
# 全部编译为模块 (.ko)，运行时由 /usr/bin/wifibroadcast 按 USB VID:PID
# 只 insmod 与当前网卡匹配的那一个，不会同时占住 DWC3 主机控制器。
BR2_PACKAGE_RTL8812AU_OPENIPC=y
# RTL8814AU 已移除：4x4 卡在 16MB 方案上体积不划算，且 8812AU 覆盖同样场景。
#   （原 BR2_PACKAGE_RTL8814AU_OPENIPC 已移除：本工程不再提供该包）
# RTL8812CU 已移除：libc0607/rtl88x2cu 只声明支持内核 6.12，本平台是
# 4.9.37，没有 4.9 上的实证，是三张卡里最不可靠的一张。省下约 0.6 MB。
#   （原 BR2_PACKAGE_RTL88X2CU_OPENIPC 已移除：本工程不再提供该包）
BR2_PACKAGE_RTL8733BU_OPENIPC=y
# MT7921AU 不在此列：其唯一驱动 mt76/mt7921u 要求内核 >= 6.12，
# 而本平台内核锁定 4.9.37，无法编译。详见 docs/网卡与传感器兼容性.md

# ---- 已裁掉（16MB flash 空间不足，且 FPV 用不到）---------------------------
# mosquitto / zerotier-one / wireguard / uacme / vtund / lame / quirc /
# divinus / rtl8188fu / rtl8189fs
# BR2_PACKAGE_MOSQUITTO is not set
# BR2_PACKAGE_ZEROTIER_ONE is not set
# BR2_PACKAGE_WIREGUARD_TOOLS is not set
# BR2_PACKAGE_WIREGUARD_LINUX_COMPAT is not set
# BR2_PACKAGE_UACME_OPENIPC is not set
# BR2_PACKAGE_VTUND_OPENIPC is not set
# BR2_PACKAGE_LAME_OPENIPC is not set
# BR2_PACKAGE_QUIRC_OPENIPC is not set
# BR2_PACKAGE_DIVINUS is not set
# BR2_PACKAGE_RTL8188FU_OPENIPC is not set
# BR2_PACKAGE_RTL8189FS_OPENIPC is not set
#
# ---- 注意：下面这两个**关不掉** --------------------------------------------
# BR2_PACKAGE_OPUS_OPENIPC is not set
# BR2_PACKAGE_OPUS_OPENIPC_FIXED_POINT is not set
# BR2_PACKAGE_LIBOGG_OPENIPC is not set
#
# 写 "is not set" 是无效的，别以为这样就把它们排除了。majestic 的 .mk 里
# 直接声明了依赖：
#
#     MAJESTIC_DEPENDENCIES = ... libogg-openipc opus-openipc
#
# Buildroot 会照着 .mk 的依赖关系去建这两个包，**kconfig 符号管不着**。
# 已用 br-show-info 核实：opus-openipc 与 libogg-openipc 都在依赖图里，
# reverse_dependencies = ["majestic"]。它们约占 400 KB，是本工程去不掉的
# 成本 —— majestic 是编码器主力，不能删。详见 docs/网卡与传感器兼容性.md §6。

BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
# 明确关掉 TLS：本镜像里 curl 只有一处用到，就是 wifibroadcast 脚本读
# majestic 的 http://localhost/api/v1/config.json（明文本机回环）。
# 上游 ultimate 之所以带 mbedtls，是为了 uacme 申请 Let's Encrypt 证书；
# 本镜像已裁掉 uacme，TLS 也就没有使用方了。显式写死，免得上游改默认值时
# 悄悄把 mbedtls 又拉回来（那会多吃几百 KB flash）。
BR2_PACKAGE_LIBCURL_OPENIPC_TLS_NONE=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_LIBEVENT_OPENIPC=y
BR2_PACKAGE_YAML_CLI=y

BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_GENERAL_PATH)/scripts/post-image-split.sh"
