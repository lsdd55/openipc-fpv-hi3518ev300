#!/bin/sh
#
# 空中端 (drone / TX) 图传启动脚本
#
# 本文件是上游 OpenIPC general/package/wifibroadcast-ng/files/wifibroadcast
# 的定制版本，改动集中在四处，其余逻辑（wfb_tx/wfb_rx/wfb_tun/msposd 的
# 启动顺序与参数）保持上游原样：
#
#   1. load_modules(): 提供 VID:PID → 驱动名映射，
#      并且改为「先卸载全部候选驱动，再只加载匹配的那一个」。
#      原因：上游 rtl8812au 的 ID 表认领了 0bda:8812/881a，
#      两个模块都在 /lib/modules 里时，mdev 的 modalias 自动加载可能先把
#      错误的驱动绑上去，之后 wfb_tx 注入就发不出去。
#
#   2. video_settings(): F23 传感器（libsns_f23.so）只实现
#      linear_1080p30 与 2wdr1_1080p30 两种模式，物理上没有 60fps，
#      所以不再硬写 fps 60，改为从 /etc/fpv-video.conf 读取。
#
#   3. video_settings(): 显式指定 hi3516ev200 家族的传感器 ini
#      (/etc/sensors/jxf23_i2c_1080p.ini)。上游拼的是
#      <sensor>_<family>.bin —— 那是 SigmaStar 的命名，海思这边会指向
#      一个不存在的文件。
#
#   4. load_interface(): txpower 换算按驱动家族分流，不再是
#      「只有 8812au 特殊、其余都算 50」的二选一。
#
#   5. load_modules(): 按卡种修正 wfb.yaml 的 stbc/ldpc（上游只在
#      video_settings 里按 lsusb 写一次，而且不刷新本次运行的变量，
#      要等第二次启动才生效）。这里写完立即刷新，当次启动就生效。
#

wfb_key=/etc/drone.key
wfb_cfg=/etc/wfb.yaml
video_cfg=/etc/fpv-video.conf
wfb_dev=wlan0

# 我们编进镜像的驱动模块名，顺序即优先级。
#
# 8812au 与 88XXau 是同一个驱动的两种叫法：OpenIPC 的 rtl8812au_fpv 分支
# 里是 `MODULE_NAME = 8812au`（已核对上游 Makefile 的 HAL_RTL8812A 段，
# 无条件赋值），而 aircrack-ng 的 rtl8812au 用的是 88XXau。本工程用的是
# OpenIPC 的分支，所以主名是 8812au；88XXau 留着只为把误装过的模块卸掉。
ALL_DRIVERS="8812au 88XXau 8733bu"

echo_log() {
	echo "$1" | logger -s -t wifibroadcast
}

# ---------------------------------------------------------------- 配置读取

wfb_yaml() {
	if [ -e "$1" ]; then
		while IFS=: read -r key value; do
			key=$(eval echo "$key")
			value=$(eval echo "$value")
			[ -n "$key" ] && export "$key=$value"
		done < "$1"
	fi
}

load_config() {
	wfb_yaml /rom"$wfb_cfg"
	wfb_yaml "$wfb_cfg"
	[ ! -e "$wfb_key" ] && wfb_key=/rom"$wfb_key"

	# 视频剖面：先给默认值，再让 /etc/fpv-video.conf 覆盖
	VIDEO_SIZE="1920x1080"
	VIDEO_FPS="30"
	VIDEO_CODEC="h264"
	VIDEO_BITRATE="10000"
	VIDEO_RCMODE="cbr"
	SENSOR_INI="/etc/sensors/jxf23_i2c_1080p.ini"
	if [ -e "$video_cfg" ]; then
		while IFS='=' read -r k v; do
			case "$k" in
				''|\#*) continue ;;
			esac
			k=$(echo "$k" | tr -d ' \t')
			v=$(echo "$v" | tr -d ' \t\r')
			case "$k" in
				VIDEO_SIZE|VIDEO_FPS|VIDEO_CODEC|VIDEO_BITRATE|VIDEO_RCMODE|SENSOR_INI)
					eval "$k=\$v"
					;;
			esac
		done < "$video_cfg"
	fi
}

# ---------------------------------------------------------------- 网卡识别
#
# lsusb 长这样（字段位置会随 Bus 号位数漂移，所以不用 awk '{print $6}'）：
#   Bus 001 Device 002: ID 0bda:8812 Realtek Semiconductor Corp. ...
#
usb_ids() {
	lsusb 2>/dev/null \
		| sed -n 's/.*ID \([0-9a-fA-F]\{4\}:[0-9a-fA-F]\{4\}\).*/\1/p' \
		| tr 'A-F' 'a-f'
}

driver_of_pid() {
	case "$1" in
		# RTL8812AU / RTL8811AU —— 上游 openipc/realtek-wlan rtl8812au_fpv
		0bda:8812|0bda:881a|0b05:17d2|2357:0101|2604:0012)
			echo 8812au ;;



		# RTL8733BU —— 上游 openipc/realtek-wlan rtl8733bu_fpv
		0bda:f72b|0bda:b733)
			echo 8733bu ;;
	esac
}

# 注意：本函数在 $( ) 里被调用，stdout 只能输出驱动名。
# 任何日志都必须走 stderr，否则会污染返回值。
detect_driver() {
	for id in $(usb_ids); do
		d=$(driver_of_pid "$id")
		if [ -n "$d" ]; then
			echo "$d"
			return 0
		fi
	done
	return 1
}

unload_all_drivers() {
	for m in $ALL_DRIVERS; do
		modprobe -r "$m" 2>/dev/null
	done
}

# 按需写 wfb.yaml 的一个键：值与现值相同就不动，避免每次启动都改动
# /etc 上的可写层。返回 0 表示「现在值已经是目标值」。
set_yaml_if_changed() {
	cur=$(yaml-cli -i "$wfb_cfg" -g "$1" 2>/dev/null)
	[ "$cur" = "$2" ] && return 0
	if yaml-cli -i "$wfb_cfg" -s "$1" "$2" 2>/dev/null; then
		echo_log "wfb.yaml: $1 = $2（原 ${cur:-空}）"
		return 0
	fi
	return 1
}

pick_wfb_dev() {
	for n in /sys/class/net/wlan*; do
		[ -e "$n" ] || continue
		wfb_dev=${n##*/}
		return 0
	done
	return 1
}

load_modules() {
	driver=$(detect_driver) || {
		echo_log "未识别到受支持的 USB 无线网卡，已知列表见 /etc/fpv-usb-ids.txt"
		exit 1
	}

	# 先清干净：避免 mdev 依 modalias 把不匹配的模块抢先绑上设备
	unload_all_drivers
	sleep 1

	opt1=""
	opt2=""
	adapter_id=""
	# STBC / LDPC：上游对 8812au 是 1/1、对 8733bu 是 0/0。
	# 依据是硬件能力 —— STBC 需要至少 2 条发射链，8733bu 是 1T1R 用不了。
	# 这两项只影响发送端编码，地面端 wfb_rx 自动识别，不用同步改。
	card_stbc=""
	card_ldpc=""
	case "$driver" in
		8812au|88XXau)
			# 上游对 8812au 不加空载参数，保持原样
			adapter_id="bl-r8812af1"
			card_stbc=1
			card_ldpc=1
			;;
		8733bu)
			opt1="rtw_tx_pwr_by_rate=0"
			opt2="rtw_tx_pwr_lmt_enable=0"
			adapter_id="bl-m8731bu4"
			card_stbc=0
			card_ldpc=0
			;;
	esac

	echo_log "Loading $driver ${opt1} ${opt2}"
	alt_name=""
	case "$driver" in
		# 同一个驱动的两种叫法（OpenIPC 分支叫 8812au，aircrack 叫 88XXau）
		8812au) alt_name=88XXau ;;
	esac
	if ! modprobe "$driver" $opt1 $opt2 MaxTxBufLen=32; then
		if [ -n "$alt_name" ] && modprobe "$alt_name" $opt1 $opt2 MaxTxBufLen=32; then
			echo_log "主名 $driver 加载失败，改用 $alt_name 成功"
			driver=$alt_name
		else
			echo_log "modprobe $driver 失败（也试过 ${alt_name:-无备名}）"
			exit 1
		fi
	fi

	# 等接口出现（最多 ~15s）
	i=0
	while [ $i -lt 15 ]; do
		pick_wfb_dev && break
		i=$((i + 1))
		sleep 1
	done

	if ! pick_wfb_dev; then
		echo_log "驱动已加载但没出现 wlan 接口"
		exit 1
	fi
	echo_log "wfb_dev=$wfb_dev"

	if ! ifconfig "$wfb_dev" up; then
		echo_log "ifconfig $wfb_dev up 失败"
		exit 1
	fi

	if [ -n "$adapter_id" ]; then
		yaml-cli-multi -i /etc/wfb.yaml -s .wireless.wlan_adapter "$adapter_id" 2>/dev/null
	fi

	# 按卡种修正 stbc/ldpc，并立即刷新 shell 变量 ——
	# 上游只写 yaml、不刷新，所以那些值要等下一次启动才生效；这里当场生效。
	if [ -n "$card_stbc" ] && set_yaml_if_changed .broadcast.stbc "$card_stbc"; then
		stbc=$card_stbc
	fi
	if [ -n "$card_ldpc" ] && set_yaml_if_changed .broadcast.ldpc "$card_ldpc"; then
		ldpc=$card_ldpc
	fi
}

# ---------------------------------------------------------------- 接口配置

load_mlink() {
	# MTU 决定 wfb 的单帧预算，进而决定 majestic 的 NALU 上限。
	# 这里设得比上游的 1500 大（见 /etc/wfb.yaml 的 mlink），是为了 1080p
	# 的大 I 帧少分几片、少一点开销。
	#
	# 但 Realtek USB 驱动不一定接受这么大的 MTU，而且 ifconfig 失败时未必
	# 报错 —— 如果只下发不校验，就会出现「naluSize 按 3994 算、实际 MTU 还是
	# 1500」的错配，majestic 产出的 NALU 被二次分片，反而更容易丢。
	# 所以设完回读 /sys 里的真实值，按真实值反推 naluSize。
	ifconfig "$wfb_dev" mtu "$mlink" 2>/dev/null
	actual=$(cat "/sys/class/net/$wfb_dev/mtu" 2>/dev/null)
	if [ -n "$actual" ] && [ "$actual" -lt "$mlink" ] 2>/dev/null; then
		echo_log "驱动只接受 MTU $actual（请求 $mlink），按实际值调 naluSize"
		mlink=$actual
	fi

	# 让 majestic 的 NALU 不超过 wfb 的单帧预算
	nalu=$((mlink - 100))
	if [ "$(cli -g .rtsp.naluSize 2>/dev/null)" != "$nalu" ]; then
		cli -s .rtsp.naluSize "$nalu" 2>/dev/null && killall -1 majestic 2>/dev/null
	fi
}

load_interface() {
	iw "$wfb_dev" set monitor none 2>/dev/null

	[ "$width" = "40" ] && wfb_width=HT40+ || wfb_width=HT20
	iw "$wfb_dev" set channel "$channel" "$wfb_width"

	# 必须放在 set channel 之后：切信道会重置驱动的功率表
	iw reg set 00

	case "$driver" in
		# rtw 系（Realtek out-of-tree）：驱动把 iw 的 dBm*100 再取负解释
		8812au|88XXau)
			wfb_power=$((txpower * -100))
			;;
		# 8733bu 分支的换算与上游保持一致
		*)
			wfb_power=$((txpower * 50))
			;;
	esac
	iw "$wfb_dev" set txpower fixed "$wfb_power" 2>/dev/null

	echo_log "channel=$channel width=$wfb_width mcs=$mcs_index fec=$fec_k/$fec_n power=$wfb_power"
}

# ---------------------------------------------------------------- 视频剖面

video_settings() {
	# 传感器模式文件：F23 在 hi3516ev200 家族里叫 jxf23_*
	if [ -f "$SENSOR_INI" ]; then
		cli -s .isp.sensorConfig "$SENSOR_INI"
	else
		echo_log "警告：$SENSOR_INI 不存在，交给 majestic 自动探测"
	fi

	cli -s .isp.exposure 16
	cli -s .video0.size "$VIDEO_SIZE"
	cli -s .video0.fps "$VIDEO_FPS"
	cli -s .video0.codec "$VIDEO_CODEC"
	cli -s .video0.bitrate "$VIDEO_BITRATE"
	cli -s .video0.rcMode "$VIDEO_RCMODE"
	# 3DNR 关掉换低延迟
	cli -s .fpv.noiseLevel 0 2>/dev/null
	cli -s .video0.noiseLevel 0

	cli -s .outgoing.wfb true
	cli -s .records.split 1
	cli -s .records.notime true
	cli -s .fpv.enabled true

	echo_log "video: $VIDEO_SIZE@${VIDEO_FPS} $VIDEO_CODEC ${VIDEO_BITRATE}kbps $VIDEO_RCMODE"
}

# ---------------------------------------------------------------- wfb 进程

start_broadcast() {
	echo_log "Starting wfb_tx (mcs=$mcs_index fec=$fec_k/$fec_n ch=$channel)"
	wfb_tx -K "$wfb_key" -M "$mcs_index" -B "$width" -k "$fec_k" -n "$fec_n" \
		-U rtp_local -S "$stbc" -L "$ldpc" -i "$link_id" \
		-C 8000 -J 10 -E 5000 "$wfb_dev" >/dev/null 2>&1 &
}

load_wfb() {
	wfb_rx -K "$wfb_key" -i "$link_id" -p "$1" -u "$3" "$wfb_dev" >/dev/null 2>&1 &
	wfb_tx -K "$wfb_key" -M "$tun_index" -B "$width" -k "$fec_k" -n "$fec_n" \
		-S "$stbc" -L "$ldpc" -i "$link_id" -p "$2" -u "$4" "$wfb_dev" >/dev/null 2>&1 &
}

start_tunnel() {
	echo_log "Starting wfb_tun"
	load_wfb 160 32 5800 5801
	wfb_tun -a 10.5.0.10/24 > /dev/null &
}

start_telemetry() {
	port_rx=14550
	port_tx=14551

	echo_log "Starting $router"
	load_wfb 144 16 "$port_rx" "$port_tx"

	if [ "$router" = "mavfwd" ]; then
		mavfwd -b 115200 -c 8 -p 100 -a 15 -t -m /dev/"$serial" \
			-o 127.0.0.1:"$port_tx" -i 127.0.0.1:"$port_rx" > /dev/null &
	else
		if [ "$router" = "msposd" ]; then
			size=$(curl -s localhost/api/v1/config.json | jsonfilter -qe "@.video0.size")
		fi
		msposd -b 115200 -c 8 -r "$osd_fps" -m /dev/"$serial" \
			-o 127.0.0.1:"$port_tx" -z "$size" > /dev/null &
	fi
}

# ---------------------------------------------------------------- 入口

stop() {
	for process in wfb_rx wfb_tx wfb_tun msposd mavfwd; do
		if [ -n "$(pidof $process)" ]; then
			echo_log "Stopping $process"
			killall -q "$process"
		fi
	done
}

start() {
	load_config
	load_modules
	load_mlink
	load_interface

	if [ ! -e /etc/system.ok ]; then
		video_settings
		touch /etc/system.ok
		killall -1 majestic 2>/dev/null
	fi

	stop
	start_broadcast
	start_tunnel
	start_telemetry
}

case "$1" in
	start|stop)
		$1
		;;

	reset)
		# 必须先 load_config：VIDEO_SIZE / VIDEO_FPS / VIDEO_CODEC / VIDEO_BITRATE /
		# VIDEO_RCMODE / SENSOR_INI 都只在 load_config() 里赋值。缺了这一步，
		# video_settings 会把上面这些键全部写成空字符串，把 majestic 配置毁掉。
		load_config
		cp -f /rom"$wfb_cfg" "$wfb_cfg"
		rm -f /etc/majestic.yaml /etc/system.ok
		video_settings
		echo_log "已恢复出厂配置，请重启后生效（reboot）"
		;;

	detect)
		# 现场排障用：只打印识别结果，不启停任何东西
		for id in $(usb_ids); do
			d=$(driver_of_pid "$id")
			echo "$id -> ${d:-未知}"
		done
		;;

	cli)
		shift
		yaml-cli -i "$wfb_cfg" "$@"
		;;

	*)
		echo "Usage: $0 {start|stop|reset|detect|cli}"
		exit 1
		;;
esac
